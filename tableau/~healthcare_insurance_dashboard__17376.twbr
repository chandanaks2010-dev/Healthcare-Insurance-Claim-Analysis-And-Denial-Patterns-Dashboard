      <aliases enabled='yes' />
      <column caption='Claim Volume' datatype='integer' name='[Calculation_0250183298187266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([claim_id])' />
      </column>
      <column caption='Is Top N Hospital' datatype='boolean' name='[Calculation_0250183298584579]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(COUNT([claim_id]), &apos;desc&apos;) &lt;= [Parameters].[Parameter 0250183296770048]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running Claim Count' datatype='integer' name='[Calculation_0250183299764228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(COUNT([claim_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative % ' datatype='real' name='[Calculation_0250183300161541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(RUNNING_SUM(SUM([claim_amount])) / WINDOW_SUM(SUM([claim_amount]))) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall Avg Claim Amount' datatype='real' name='[Calculation_0250183325560840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([claim_amount]) }' />
      </column>
      <column caption=' Hospital Avg Claim Amount' datatype='real' name='[Calculation_0250183337975817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [hospital_name] : AVG([claim_amount]) }' />
      </column>
      <column caption='Difference vs Overall Avg' datatype='real' name='[Calculation_0250183338102794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0250183337975817] - [Calculation_0250183325560840]' />
      </column>
      <column caption='Above or Below Avg' datatype='string' name='[Calculation_0250183339335691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0250183338102794] &gt;= 0 THEN &quot;Above Avg&quot; ELSE &quot;Below Avg&quot; END' />
      </column>
      <column caption='Specialty Denial Rate' datatype='real' name='[Calculation_0250183340785676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [specialty] : SUM([denial_flag]) / COUNT([claim_id]) }' />
      </column>
      <column caption='Portfolio Denial Rate' datatype='real' name='[Calculation_0250183340937229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([denial_flag]) / COUNT([claim_id]) }' />
      </column>
      <column caption='Specialty Denial Gap vs Portfolio' datatype='real' name='[Calculation_0250183341080590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0250183340785676] - [Calculation_0250183340937229]' />
      </column>
      <column caption='Above or Below Portfolio' datatype='string' name='[Calculation_0250183342817295]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0250183341080590] &gt;= 0 THEN &quot;Above Portfolio&quot; ELSE &quot;Below Portfolio&quot; END' />
      </column>
      <column caption='Region Avg Claim Amount' datatype='real' name='[Calculation_0250183343620112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region] : AVG([claim_amount]) }' />
      </column>
      <column caption='Portfolio Avg Claim Amount' datatype='real' name='[Calculation_0250183343747089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([claim_amount]) }' />
      </column>
      <column caption=' Region Cost Gap' datatype='real' name='[Calculation_0250183343865874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0250183343620112] - [Calculation_0250183343747089]' />
      </column>
      <column caption='Average Claim Amount' datatype='real' name='[Calculation_0250183346724883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([claim_amount]) / COUNT([claim_id])' />
      </column>
      <column caption='Denial Rate %' datatype='real' name='[Calculation_0720225633472513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [claim_status] = &quot;Denied&quot; THEN 1 ELSE 0 END) / COUNTD([claim_id])' />
      </column>
      <column caption='Running % of Claims' datatype='real' name='[Calculation_1297880429772800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([claim_id]) / WINDOW_SUM(COUNT([claim_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Approval Flag' datatype='integer' name='[Calculation_1652335126671360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] = &apos;Approved&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Approval Rate' datatype='real' name='[Calculation_1652335126831105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1652335126671360]) / COUNT([claim_id])' />
      </column>
      <column caption='Average Cost per Claim' datatype='real' name='[Calculation_1652335127027714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([claim_amount]) / COUNT([claim_id])' />
      </column>
